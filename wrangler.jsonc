{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jamaica-fishing-logs",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
"keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "fishing-logs-db", "database_id": "cda939f6-29e4-4314-9b46-a081af8ba097" }
  ]
}
