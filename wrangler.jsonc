    "TURNSTILE_SECRET": "0x4AAAAAAFUFQWX6nXpo60NNcxLcy1m6pAg",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFUFQdzX_tEqlkMa"
  },
}
