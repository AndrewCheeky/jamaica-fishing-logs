{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jamaica-fishing-logs",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "fishing-logs-db", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }
  ]
}
